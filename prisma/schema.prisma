generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DocumentType {
  DNI
  CE
  PASSPORT
  RUC
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  COHABITANT
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  COMPLICATION
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  CHRONIC
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum BackgroundType {
  PERSONAL
  FAMILY
  SURGICAL
  PHARMACOLOGICAL
  OBSTETRIC
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Specialty {
  GENERAL_MEDICINE
  PSYCHOLOGY
  PSYCHIATRY
  NUTRITION
  PHYSIOTHERAPY
  OTHER
}

enum NoteTemplate {
  SOAP
  PSYCHOLOGY
  NUTRITION
  PHYSIOTHERAPY
}

enum ReferralUrgency {
  ROUTINE
  PRIORITY
  URGENT
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditAction {
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  PATIENT_EXPORTED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  DOCUMENT_DOWNLOADED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_STATUS_CHANGED
  APPOINTMENT_RSVP
  CONSULTATION_CREATED
  CONSULTATION_UPDATED
  PRESCRIPTION_CREATED
  PRESCRIPTION_DELETED
  PRESCRIPTION_EXPORTED
  REFERRAL_CREATED
  REFERRAL_UPDATED
  USER_CREATED
  USER_UPDATED
  ORGANIZATION_UPDATED
  LOGIN_SUCCEEDED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ruc       String?  @unique
  address   String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  patients Patient[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(DOCTOR)
  speciality  String?
  specialty   Specialty @default(GENERAL_MEDICINE)
  avatar      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  licenseNumber String?

  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  consultations     ClinicalRecord[]
  appointments      Appointment[]
  uploadedDocuments PatientDocument[]
  prescriptions     Prescription[]
  auditLogs         AuditLog[]
  referralsSent     Referral[]        @relation("ReferralFrom")
  referralsReceived Referral[]        @relation("ReferralTo")

  @@map("users")
}

model Patient {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  documentType    DocumentType  @default(DNI)
  documentNumber  String        @unique
  birthDate       DateTime
  gender          Gender
  phone           String?
  email           String?
  address         String?
  city            String?
  bloodType       BloodType?
  maritalStatus   MaritalStatus?
  occupation      String?
  insuranceNumber String?

  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String?

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  clinicalRecords    ClinicalRecord[]
  appointments       Appointment[]
  allergies          Allergy[]
  medicalBackgrounds MedicalBackground[]
  documents          PatientDocument[]
  prescriptions      Prescription[]
  referrals          Referral[]

  @@map("patients")
}

model PatientDocument {
  id           String   @id @default(cuid())
  patientId    String
  name         String
  description  String?
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  createdAt    DateTime @default(now())

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@map("patient_documents")
}

model ClinicalRecord {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  date        DateTime @default(now())
  reason      String
  subjective  String?  @db.Text
  objective   String?  @db.Text
  assessment  String?  @db.Text
  plan        String?  @db.Text
  notes        String?      @db.Text
  noteTemplate NoteTemplate @default(SOAP)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        User           @relation(fields: [doctorId], references: [id])
  vitalSigns    VitalSigns?
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  referrals     Referral[]

  @@map("clinical_records")
}

model VitalSigns {
  id               String   @id @default(cuid())
  consultationId   String   @unique
  height           Float?
  weight           Float?
  bmi              Float?
  temperature      Float?
  bloodPressureSys Int?
  bloodPressureDia Int?
  heartRate        Int?
  oxygenSat        Float?
  respiratoryRate  Int?
  glucoseLevel     Float?
  createdAt        DateTime @default(now())

  consultation ClinicalRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("vital_signs")
}

model Diagnosis {
  id             String          @id @default(cuid())
  consultationId String
  code           String
  description    String
  type           DiagnosisType   @default(PRIMARY)
  status         DiagnosisStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())

  consultation ClinicalRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model Allergy {
  id        String          @id @default(cuid())
  patientId String
  allergen  String
  reaction  String?
  severity  AllergySeverity @default(MILD)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

model MedicalBackground {
  id          String         @id @default(cuid())
  patientId   String
  type        BackgroundType
  description String
  date        DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_backgrounds")
}

model Prescription {
  id             String   @id @default(cuid())
  consultationId String
  patientId      String
  doctorId       String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultation ClinicalRecord     @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id])
  doctor       User               @relation(fields: [doctorId], references: [id])
  items        PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  medication     String
  dosage         String
  frequency      String
  duration       String
  quantity       String?
  instructions   String?
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  doctorId  String
  dateTime  DateTime
  duration  Int               @default(30)
  status    AppointmentStatus @default(SCHEDULED)
  reason    String
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  googleEventId   String?
  rsvpToken       String?  @unique
  reminderSentAt  DateTime?
  arrivedAt       DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation(fields: [doctorId], references: [id])

  @@map("appointments")
}

model Referral {
  id             String          @id @default(cuid())
  patientId      String
  fromDoctorId   String
  toDoctorId     String?
  toSpecialty    Specialty
  reason         String          @db.Text
  urgency        ReferralUrgency @default(ROUTINE)
  status         ReferralStatus  @default(PENDING)
  notes          String?         @db.Text
  consultationId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromDoctor   User            @relation("ReferralFrom", fields: [fromDoctorId], references: [id])
  toDoctor     User?           @relation("ReferralTo", fields: [toDoctorId], references: [id])
  consultation ClinicalRecord? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([fromDoctorId, status])
  @@index([toDoctorId, status])
  @@map("referrals")
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         AuditAction
  entityType     String
  entityId       String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser     User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
