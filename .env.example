# Base de datos PostgreSQL
# Si usas docker-compose, la URL es:
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/historia_clinica"
DIRECT_URL="postgresql://postgres:postgres123@localhost:5432/historia_clinica"

# Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET="generate-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google Calendar (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email para recordatorios (opcional — Gmail, SMTP, etc.)
MAIL_USER=
MAIL_PASS=

# Cron jobs (genera un string secreto cualquiera)
CRON_SECRET=
